go_test(
    name = "video_test",
    srcs = ["window_darwin_test.go"],
    embed = [":video"],
    deps = select({
        "@rules_go//go/platform:darwin": [
            "@com_github_egoist_mygo//ui",
        ],
        "//conditions:default": [],
    }),
